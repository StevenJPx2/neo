{
  "name": "neo",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight remote iPhone Safari WebDriver harness with an agent-facing API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "phone": "tsx src/phone/cli.ts",
    "phone:mcp": "tsx src/phone/server.ts",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@typesafe-ai/sdk": "0.7.0",
    "zod": "4.6.7"
  }
}
